#!/usr/bin/env bash
# openmagpie — một lệnh: cài nếu thiếu, bật nếu chưa chạy, in link web
# đã kèm key (bấm là vào, không phải dán gì).
set -u

export PATH="$HOME/.local/bin:$PATH"

CONF="$HOME/.config/magpie"
KEY_FILE="$CONF/web-key"
STATE="$HOME/.local/state/magpie"
PID_FILE="$STATE/headless.pid"
LOG="$STATE/headless.log"
PORT="${MAGPIE_WEB_PORT:-3430}"

say()  { printf '%s\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
die()  { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- cài đặt
if ! command -v magpie >/dev/null 2>&1; then
  say "chưa có magpie; đang cài bản terminal…"
  installer=$(mktemp)
  curl -fsSL https://usemagpie.ai/install.sh -o "$installer" || die "không tải được usemagpie.ai/install.sh"
  MAGPIE_CLI=1 sh "$installer" >/dev/null 2>&1 || die "installer lỗi"
  rm -f "$installer"
  command -v magpie >/dev/null 2>&1 || die "đã cài nhưng không thấy trên PATH (thêm ~/.local/bin)"
  ok "đã cài $(magpie --version 2>/dev/null | head -1)"
fi

# ------------------------------------------------------------------- key
mkdir -p "$CONF" "$STATE"
if [ ! -s "$KEY_FILE" ]; then
  head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$KEY_FILE"
  chmod 600 "$KEY_FILE"
fi
KEY=$(cat "$KEY_FILE")

# --------------------------------------------------------------- đang chạy?
running=no
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  running=yes
fi
# Trang trả lời mới là bằng chứng thật, không phải pid.
if ! curl -fsS -o /dev/null -m 2 "http://127.0.0.1:$PORT/?k=$KEY" 2>/dev/null; then
  running=no
fi

if [ "$running" = no ]; then
  say "đang bật magpie (gateway + web UI)…"
  # Dừng phần còn sót trước, theo pid (pattern sẽ khớp cả shell này).
  for pid in $(pgrep -f '^magpie serve' 2>/dev/null); do kill "$pid" 2>/dev/null; done
  sleep 1
  setsid nohup "$HOME/.local/bin/magpie-headless" >/dev/null 2>&1 </dev/null &
  disown 2>/dev/null || true
  for _ in $(seq 1 25); do
    curl -fsS -o /dev/null -m 2 "http://127.0.0.1:$PORT/?k=$KEY" 2>/dev/null && break
    sleep 1
  done
  curl -fsS -o /dev/null -m 2 "http://127.0.0.1:$PORT/?k=$KEY" 2>/dev/null \
    || die "không lên được; xem $LOG"
  ok "đã bật"
fi

# ------------------------------------------------------------------ link
# Cloud Shell phục vụ cổng ở https://<port>-<WEB_HOST>/.
if [ -n "${WEB_HOST:-}" ]; then
  URL="https://$PORT-$WEB_HOST/?k=$KEY"
else
  URL="http://127.0.0.1:$PORT/?k=$KEY"
fi
LOCAL="http://127.0.0.1:$PORT/?k=$KEY"

# OSC 8: link bấm được trong terminal; in thêm URL thường cho terminal khác.
LINK=$'\e]8;;'"$URL"$'\e\\'"$URL"$'\e]8;;\e\\'

say ""
printf '  \033[1mmagpie\033[0m đang chạy · gateway \033[36mhttp://127.0.0.1:3425\033[0m\n'
say ""
say "  Mở (đã đăng nhập sẵn, key nằm trong link):"
say ""
printf '    %s\n' "$LINK"
say ""
say "  Key, nếu có form nào hỏi:"
printf '    \033[1m%s\033[0m\n' "$KEY"
say ""
if magpie providers 2>/dev/null | grep -q "no providers yet"; then
  warn "chưa có provider nào — danh sách model sẽ rỗng cho tới khi thêm"
  say "    bash scripts/login.sh   (hoặc Add a provider trong UI)"
  say ""
fi
say "  Máy khác thì tunnel cổng thay vì dùng link:"
say "    ssh -L $PORT:127.0.0.1:$PORT <máy-này>"
say "    rồi mở $LOCAL"
say ""
say "  Trạng thái: magpie-headless-status · Tắt: magpie-headless-stop · Log: $LOG"
say ""
