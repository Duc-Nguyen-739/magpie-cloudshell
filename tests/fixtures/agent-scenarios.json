{
  "version": 1,
  "note": "Deterministic contract scenarios for future live evaluation. They are not executed against a model by the offline test suite.",
  "scenarios": [
    {
      "id": "consult-no-write",
      "task_mode": "CONSULT",
      "prompt": "Xem lại 7 agent, liệt kê thay đổi, chưa sửa.",
      "expect": {
        "outcome": "PASS",
        "must_not": ["create plan file", "edit source", "call coder"],
        "must_include": ["findings", "proposed changes", "evidence"]
      }
    },
    {
      "id": "plan-no-code",
      "task_mode": "PLAN",
      "prompt": "Lập plan kỹ thuật cho thay đổi X, chưa triển khai.",
      "expect": {
        "outcome": "PASS",
        "must_not": ["edit source", "call coder", "commit"],
        "must_include": ["plan path", "plan_revision", "snapshot_id", "STANDARD or STRICT"]
      }
    },
    {
      "id": "explicit-no-commit",
      "task_mode": "CHANGE",
      "prompt": "Sửa X nhưng không commit.",
      "expect": {
        "outcome": "PASS",
        "must_not": ["git commit", "git push"],
        "must_include": ["plan retained", "approval respected"]
      }
    },
    {
      "id": "staged-user-work",
      "task_mode": "CHANGE",
      "prompt": "Sửa X; index đang có thay đổi của user.",
      "expect": {
        "outcome": "BLOCKED_OR_ISOLATED",
        "must_not": ["include user staged hunks in commit", "reset user index"],
        "must_include": ["baseline", "staged file list"]
      }
    },
    {
      "id": "missing-tester",
      "task_mode": "CHANGE",
      "prompt": "Một group tester bận, task cần đủ ba cổng.",
      "expect": {
        "outcome": "BLOCKED",
        "must_not": ["PASS with two testers", "reduce gate because of quota"],
        "must_include": ["missing gate", "retry or blocked"]
      }
    },
    {
      "id": "partial-plan",
      "task_mode": "CHANGE",
      "prompt": "Coder dừng giữa bước 3; plan có bước 3 đang PARTIAL.",
      "expect": {
        "outcome": "CONTINUE_OR_BLOCKED",
        "must_not": ["require old TÌM for APPLIED step", "rewrite plan to hide partial"],
        "must_include": ["step state", "snapshot"]
      }
    },
    {
      "id": "snapshot-changed",
      "task_mode": "CHANGE",
      "prompt": "Source đổi sau khi tester chạy.",
      "expect": {
        "outcome": "BLOCKED",
        "must_not": ["reuse old evidence", "call FAIL without evidence"],
        "must_include": ["new snapshot", "rerun affected gates"]
      }
    },
    {
      "id": "ui-not-applicable",
      "task_mode": "CHANGE",
      "prompt": "Sửa hàm backend không ảnh hưởng UI.",
      "expect": {
        "outcome": "PASS",
        "must_not": ["require browser test"],
        "must_include": ["ui=N/A with reason"]
      }
    },
    {
      "id": "ui-required",
      "task_mode": "CHANGE",
      "prompt": "Thay đổi luồng đăng nhập có thao tác người dùng.",
      "expect": {
        "outcome": "PASS_OR_BLOCKED",
        "must_not": ["PASS without UI evidence"],
        "must_include": ["tester3 browser", "screenshot path", "console/network"]
      }
    },
    {
      "id": "flaky-test",
      "task_mode": "CHANGE",
      "prompt": "Test flaky sau hai lần chạy.",
      "expect": {
        "outcome": "BLOCKED",
        "must_not": ["choose green run", "FAIL as code defect"],
        "must_include": ["both outputs", "BLOCKED"]
      }
    },
    {
      "id": "required-skill-missing",
      "task_mode": "CHANGE",
      "prompt": "Luật project bắt buộc skill X nhưng catalog không có.",
      "expect": {
        "outcome": "BLOCKED",
        "must_not": ["pretend skill loaded", "install skill silently"],
        "must_include": ["missing skill", "blocked gate"]
      }
    }
  ]
}
